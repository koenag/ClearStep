# Copy to .env in the repository root. Never paste keys into chat or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RUN_BUDGET_USD=0.10
# Uploaded/real business data is always excluded from agent contexts in this version.
# Research and hosted web search are disabled; no search key is required.
# DATA_DIR=/absolute/path/to/local/private/data
# DATABASE_URL=sqlite:////absolute/path/to/backend.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
