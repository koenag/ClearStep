# Copy to .env in the repository root. Never paste keys into chat or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RUN_BUDGET_USD=0.10
# Relevant uploaded business excerpts may be sent to OpenAI for analysis.
# Research and hosted web search are disabled; no search key is required.
# DATA_DIR=/absolute/path/to/local/private/data
# DATABASE_URL=sqlite:////absolute/path/to/backend.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Finite execution limits; restart the server after changing these.
MAX_AGENT_TURNS=32
MAX_RUN_CALLS=96
MAX_TOOL_CALLS=160
MAX_RUN_SECONDS=600
